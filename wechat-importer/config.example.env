# 小象智能 CRM - 微信导入工具配置示例
# 复制此文件为 .env 或直接设置环境变量

# CRM 系统地址
CRM_BASE_URL=http://localhost:3000

# 监控 API Key（在 CRM 后台的 .env 文件中配置 MONITOR_API_KEY）
CRM_API_KEY=your_monitor_api_key_here

# 微信数据目录（Windows 下通常是 我的文档\WeChat Files）
WECHAT_DATA_DIR=C:\Users\YourName\Documents\WeChat Files

# 要监控的微信用户（微信数据目录下的文件夹名）
WECHAT_USER=wxid_xxxxxxxxxxxx

# 微信数据库密钥
WECHAT_DB_KEY=your_wechat_db_key_here

# 轮询间隔（秒）
POLL_INTERVAL=10
